# Server Configuration
# These values can be updated at runtime after creating the .exe file
# Restart the application for changes to take effect

# API Server Port
API_PORT=3001

# REQUIRED — max JSON body for Express (registration logo/profile base64, large payloads)
API_JSON_BODY_LIMIT=90mb

# API file logs (.exe): HTTP + errors for port API_PORT (default logs/api.log next to .exe)
 API_LOG_ENABLED=true
 API_LOG_DIR=logs
 API_LOG_FILE=logs/api.log

# Web Server Port (for serving React app)
WEB_PORT=3000

# API Base URL (used by frontend)
# API Base URL (used by frontend)
REACT_APP_API_BASE_URL=http://localhost:3001
REACT_APP_API_CUSTOMER_SERVICE_URL=http://localhost:3004/customer-id
REACT_APP_API_SYNC_UPLOAD_URL=http://127.0.0.1:3005/sync/upload/folder
REACT_APP_API_SYNC_LOGS_URL=http://127.0.0.1:3005/sync/logs
REACT_APP_SYNC_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJjb21wYW55Ijoia2FybmljcyIsInVzZXJuYW1lIjoidmliaG9ydCJ9.mB5Kx4Q0oG75xRAw5CP94ZMSwSubDcPC-TukEMMOa2k

# Application Settings
APP_NAME=SunarKhata - Jewellery Management System
APP_VERSION=0.1.0

# Data Directory (relative to executable location)
DATA_DIR=server/data

# Build Directory (relative to executable location)
BUILD_DIR=build


# Company URL for frontend (e.g. logo link in Navbar) - use REACT_APP_ prefix so client can read it
COMPANY_URL=https://karnics.com/contact
REACT_APP_COMPANY_URL=https://karnics.com/contact

